# Required absolute paths. Keep machine-specific values in an untracked .env.
NICA_VAULT_ROOT=
NICA_STATE_ROOT=

# Candidate mode is read-only unless this is deliberately changed to true.
NICA_WRITE_ENABLED=false

# Candidate ports avoid the current production ports (4173-4176 and 3464).
CALENDAR_PORT=4273
HOMEPAGE_PORT=4274
VAULTGRAPH_PORT=4275
EMAIL_PORT=4276
BEANTIME_FAVA_PORT=4464
NICA_HOMEPAGE_URL=http://127.0.0.1:4274

# Optional integrations. Never commit populated secrets.
GOOGLE_CALENDAR_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NEXTCLOUD_CALDAV_BASE_URL=
NEXTCLOUD_CALDAV_USERNAME=
NEXTCLOUD_CALDAV_APP_PASSWORD=
CALENDAR_API_TOKEN=
PUBLIC_SFTP_PASSWORD=
