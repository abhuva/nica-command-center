# Calendar runtime settings. Keep real values outside Git.
# The migrated launcher sets NICA_CALENDAR_ENV_FILE to a local-state file.

CALENDAR_HOST=127.0.0.1
CALENDAR_PORT=4273
OBSIDIAN_VAULT_NAME=
OBSIDIAN_BASE_PATH=6. Obsidian/Live/Kalender.base
OBSIDIAN_BASE_VIEW=Tabelle
CALENDAR_INBOX_PATH=6. Obsidian/Inbox
ALLOW_MARKDOWN_FALLBACK=false
NICA_WRITE_ENABLED=false
NICA_CALENDAR_VAULT_CREATE_ENABLED=false

# Read-only Google Calendar source
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_IDS=

# Optional Google OAuth write integration; do not use for the read-only cutover
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:4273/api/google-oauth/callback
GOOGLE_OAUTH_SCOPES=
GOOGLE_OAUTH_TOKEN_FILE=google-oauth-token.json
GOOGLE_CREATE_CALENDAR_ID=

# Read-only Nextcloud CalDAV source
NEXTCLOUD_CALDAV_BASE_URL=https://cloud.example.org
NEXTCLOUD_CALDAV_USERNAME=
NEXTCLOUD_CALDAV_APP_PASSWORD=
NEXTCLOUD_CALDAV_CALENDARS=
NEXTCLOUD_CREATE_CALENDAR_ID=

# Optional public-calendar publishing; do not use for the read-only cutover
CALENDAR_PUBLIC_URL=https://calendar.example.org
CALENDAR_PUBLIC_EXPORT_DIR=public-export
CALENDAR_PUBLIC_SFTP_URL=
CALENDAR_PUBLIC_SFTP_USER=
CALENDAR_PUBLIC_SFTP_PASSWORD=
CALENDAR_PUBLIC_SFTP_HOST_FINGERPRINT_SHA256=
