{
  "name": "obsidian-homepage-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "node ./serve.mjs",
    "stop:preview": "node ./stop-preview.mjs",
    "restart:preview": "npm run stop:preview && npm run preview",
    "doctor": "node ./scripts/doctor.mjs",
    "check:runtime": "node ./tests/runtime-config-smoke.mjs",
    "check:project-creation": "node ./tests/project-creation-smoke.mjs",
    "check:calendar-vault-creation": "node ./tests/calendar-vault-creation-smoke.mjs",
    "check:email-read-shadow": "python ./tests/email_snapshot_smoke.py",
    "check:email-fetch-shadow": "python ./tests/email_fetch_shadow_smoke.py",
    "check:email-classification-shadow": "python ./tests/email_classification_shadow_smoke.py",
    "check:email-oauth-shadow": "python ./tests/email_oauth_shadow_smoke.py",
    "check:email-export-shadow": "python ./tests/email_export_shadow_smoke.py",
    "check:beantime-shadow": "node ./tests/beantime-shadow-smoke.mjs",
    "check:beantime-live-profile": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/homepage-beantime-profile-smoke.ps1",
    "check:workspace-launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/workspace-launcher-smoke.ps1",
    "lint": "eslint .",
    "lint:jsdoc": "eslint \"**/*.{js,mjs}\""
  },
  "devDependencies": {
    "eslint": "^9.24.0",
    "eslint-plugin-jsdoc": "^51.2.0"
  }
}
